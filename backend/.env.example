# Runtime profile: development, test, staging, or production.
# Staging and production enable the same fail-fast deployment validation.
APP_ENV=development

# Staging/production must use live and explicitly select demo or pro authentication.
# Demo: https://api.coingecko.com + x-cg-demo-api-key
# Pro: https://pro-api.coingecko.com + x-cg-pro-api-key
# Confirm the selected plan's production license, quota, and attribution before release.
MARKET_DATA_MODE=static
COINGECKO_API_TIER=demo
COINGECKO_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_RETRIES=1
MARKET_QUOTE_MAX_AGE_SECONDS=600
MARKET_CANDLE_MAX_LAG_SECONDS=18000

# Staging/production must set OPENAI_ENABLED explicitly. A key is required only when true.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0

# Staging/production require database mode and a postgresql+psycopg URL.
ANALYSIS_IDEMPOTENCY_MODE=memory
DATABASE_URL=
ANALYSIS_IDEMPOTENCY_RETENTION_DAYS=14

# Operational HTTP and logging policy.
ANALYSIS_TIMEOUT_SECONDS=45
MAX_REQUEST_BODY_BYTES=65536
API_DOCS_ENABLED=true
LOG_LEVEL=INFO
